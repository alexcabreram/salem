---
import Base from '../layouts/Base.astro';
import Core from '../components/Core.astro';
import World from '../components/World.astro';
import Intro from '../components/Intro.astro';
import Today from '../components/Today.astro';
import Logo from '../components/Logo.astro';

type Status = 'running' | 'building' | 'exploring';
const statusLabel: Record<Status, string> = {
  running: 'Running today',
  building: 'In development',
  exploring: 'Exploring',
};

const routes = [
  { task: 'Private or personal data', to: 'Local model', why: 'Stays on hardware you own.' },
  { task: 'Complex reasoning and planning', to: 'Claude', why: 'Frontier reasoning when the problem deserves it.' },
  { task: 'Cloud and Microsoft workflows', to: 'Azure AI', why: 'Close to the services it works with.' },
  { task: 'Writing and changing code', to: 'Coding agent', why: 'A specialist, supervised by SALEM.' },
];

const layers: { name: string; detail: string; status: Status }[] = [
  { name: 'Messaging', detail: 'Talk to SALEM from the chat app you already use.', status: 'running' },
  { name: 'Models', detail: 'Local and cloud models, selected per task by configuration.', status: 'running' },
  { name: 'Tools', detail: 'MCP servers, APIs and command-line tools, with approvals for anything risky.', status: 'building' },
  { name: 'Infrastructure', detail: 'Watch services, explain failures, propose and apply fixes.', status: 'building' },
  { name: 'Voice', detail: 'Speak to SALEM and hear it answer, at home or on the move.', status: 'exploring' },
  { name: 'Devices and home', detail: 'Presence across the places and devices around you.', status: 'exploring' },
];

const roadmap = [
  { when: 'Now', items: ['SALEM architecture', 'Local and cloud foundation', 'Agent experiments', 'MCP and tool integration', 'Multi-model experiments'] },
  { when: 'Next', items: ['SALEM World', 'Persistent context', 'Model routing', 'Voice', 'Infrastructure actions'] },
  { when: 'Later', items: ['Proactive intelligence', 'Distributed agents', 'Telephony', 'Presence across devices', 'Third-party extensions'] },
];

const principles = [
  { name: 'Persistent', text: 'Context survives individual conversations.' },
  { name: 'Provider-agnostic', text: 'No single AI provider owns the intelligence layer.' },
  { name: 'Local-first where useful', text: 'Sensitive work can stay on hardware you control.' },
  { name: 'Observable', text: 'Model choices and actions can be inspected after the fact.' },
  { name: 'User-controlled', text: 'You can see what SALEM knows and what it can reach.' },
  { name: 'Extensible', text: 'Tools, agents and providers are modules, not foundations.' },
];

const headline = [['One', 'intelligence.'], ['Everywhere', 'you', 'are.']];
---

<Base>
  <Intro />

  <header class="top wrap">
    <a href="/" class="wordmark" aria-label="SALEM home"><Logo /></a>
    <nav aria-label="Primary">
      <a href="#world">World</a>
      <a href="#architecture">Architecture</a>
      <a href="#roadmap">Roadmap</a>
      <a href="https://github.com/alexcabreram/salem">GitHub</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero wrap" aria-labelledby="hero-title" data-hero>
      <div class="hero-glow" aria-hidden="true"></div>
      <p class="stage enter" style="--d:0"><span class="stage-dot" aria-hidden="true"></span>Early stage, building in public</p>
      <h1 id="hero-title" aria-label="One intelligence. Everywhere you are.">
        {headline.map((line, l) => (
          <span class="line" aria-hidden="true">
            {line.map((w, i) => (
              <span class="w" style={`--d:${1 + l * 2 + i}`}>{w}</span>
            ))}
          </span>
        ))}
      </h1>
      <div class="hero-body enter" style="--d:6">
        <div>
          <p class="lede">
            SALEM is a persistent personal intelligence. It understands your digital world and acts across your tools,
            devices and services.
          </p>
          <p class="lede-2">AI that lives beyond the chat window.</p>
          <div class="ctas">
            <a class="btn btn-primary" href="#today" data-delegate>See it today</a>
            <a class="btn" href="#architecture">See the architecture</a>
          </div>
        </div>
        <Core class="hero-core" />
      </div>
    </section>

    <section id="today" class="section wrap split" aria-labelledby="today-title">
      <div>
        <h2 id="today-title">It speaks first.</h2>
        <div class="prose">
          <p>
            Today SALEM runs as a coordinator you reach from a messaging app. It watches the work and services it is
            connected to, tells you what changed, and keeps your task inbox in order.
          </p>
          <p>The rest of this page is where it is going. This part already works, in the founder's own setup.</p>
        </div>
        <p class="status-line"><span class="status status-running">Running today</span> Illustrative conversation. Real ones stay private.</p>
      </div>
      <Today />
    </section>

    <section id="idea" class="section wrap split" aria-labelledby="idea-title">
      <h2 id="idea-title">Your AI shouldn't disappear when the chat closes.</h2>
      <div class="prose">
        <p>
          Most assistants start from zero every time you open them. SALEM is built around the opposite idea: the
          people, projects, devices and commitments in your life persist between conversations, so every request
          starts from what is already known.
        </p>
        <p>
          It is not another chatbot or another agent framework. Models, agents and tools are parts SALEM uses. SALEM is
          what stays.
        </p>
        <ol class="flow" aria-label="How SALEM works">
          <li><span>Your world</span>Projects, people, devices, services, events, tasks</li>
          <li><span>SALEM</span>One persistent context</li>
          <li><span>Outcome</span>Reasoning and action, wherever you are</li>
        </ol>
      </div>
    </section>

    <section id="world" class="band" aria-labelledby="world-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="world-title">An intelligence that understands your world, and shows you what it knows.</h2>
          <p class="status-line"><span class="status status-exploring">Exploring</span> Illustrative example with fictional data.</p>
        </div>
        <p class="prose intro-p">
          SALEM keeps a navigable map of your digital world. Ask what it knows about a project, what changed since
          yesterday, or why it acted. Then correct it, or ask it to forget.
        </p>
        <World />
      </div>
    </section>

    <section class="section wrap" aria-labelledby="route-title">
      <div class="section-head">
        <h2 id="route-title">The right intelligence for every task.</h2>
        <p class="status-line"><span class="status status-building">In development</span> Today models are chosen by configuration. Automatic routing is next.</p>
      </div>
      <p class="prose intro-p">
        SALEM orchestrates models instead of locking your world to one provider. Models will change. The intelligence
        layer should not.
      </p>
      <dl class="routes" data-reveal>
        {routes.map((r) => (
          <div class="route" style={`--r:${routes.indexOf(r)}`}>
            <dt>{r.task}</dt>
            <dd class="route-to">{r.to}</dd>
            <dd class="route-why">{r.why}</dd>
          </div>
        ))}
      </dl>
      <p class="note">
        <strong>Exploring Claude as a reasoning layer.</strong> SALEM is evaluating Claude for complex reasoning,
        coordination between agents, tool use through MCP, and code and infrastructure workflows, while staying
        multi-model by design.
      </p>
    </section>

    <section id="architecture" class="section wrap" aria-labelledby="arch-title">
      <h2 id="arch-title">Understanding is useful. Acting is better.</h2>
      <p class="prose intro-p">
        SALEM sits above models, agents and tools. Any of them can be replaced without SALEM losing what it knows.
      </p>
      <div class="arch" data-reveal role="img" aria-label="Interfaces connect to SALEM. SALEM holds context and orchestration, and uses models, agents and tools, which run on local and cloud systems.">
        <div class="arch-row arch-thin">
          <span>Messaging</span><span>Web</span><span>Voice</span><span>Desktop</span>
        </div>
        <div class="arch-core">
          <strong>SALEM</strong>
          <span>Context, memory and orchestration</span>
        </div>
        <div class="arch-row arch-three">
          <div><strong>Models</strong><span>Claude, Azure, local models</span></div>
          <div><strong>Agents</strong><span>Research, coding, infrastructure</span></div>
          <div><strong>Tools</strong><span>MCP, APIs, CLI</span></div>
        </div>
        <div class="arch-row arch-two">
          <div><strong>Local</strong><span>Your hardware, your data, local models. For privacy, availability, latency and control.</span></div>
          <div><strong>Cloud</strong><span>Frontier models and external services. For capability and reach.</span></div>
        </div>
      </div>

      <h3 class="sub">What it can reach</h3>
      <p class="prose sub-p">
        Each capability is a layer with its own permissions. Running today means it works in the founder's own setup,
        not that it is available to others yet.
      </p>
      <ul class="layers">
        {layers.map((l) => (
          <li>
            <h4>{l.name}</h4>
            <p>{l.detail}</p>
            <span class={`status status-${l.status}`}>{statusLabel[l.status]}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="roadmap" class="section wrap" aria-labelledby="roadmap-title">
      <h2 id="roadmap-title">Roadmap</h2>
      <p class="prose intro-p">What exists, what is being built and what is still an idea. Nothing below is presented as finished.</p>
      <ol class="roadmap">
        {roadmap.map((r) => (
          <li>
            <h3>{r.when}</h3>
            <ul>{r.items.map((i) => <li>{i}</li>)}</ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="section wrap" aria-labelledby="principles-title">
      <h2 id="principles-title">Principles</h2>
      <dl class="principles">
        {principles.map((p) => (
          <div>
            <dt>{p.name}</dt>
            <dd>{p.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section id="about" class="section wrap split" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <div class="prose">
        <p>
          SALEM is an independent experiment exploring what personal AI could become when intelligence is no longer
          confined to a chat window.
        </p>
        <p>
          It is built by Alex Cabrera, an AI engineer focused on agentic systems, automation and AI architecture.
        </p>
        <p class="links">
          <a href="https://github.com/alexcabreram">GitHub</a>
          <a href="https://www.linkedin.com/in/alexcabreram/">LinkedIn</a>
          <a href="mailto:hello@getsalem.dev">hello@getsalem.dev</a>
        </p>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <div>
      <p class="wordmark"><Logo size={20} /></p>
      <p class="foot-tag">One intelligence. Everywhere you are.</p>
    </div>
    <nav aria-label="Footer">
      <a href="https://github.com/alexcabreram/salem">GitHub</a>
      <a href="#architecture">Architecture</a>
      <a href="#roadmap">Roadmap</a>
      <a href="mailto:hello@getsalem.dev">Contact</a>
    </nav>
  </footer>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const glow = hero?.querySelector<HTMLElement>('.hero-glow');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (hero && glow && !still && window.matchMedia('(pointer: fine)').matches) {
    let raf = 0;
    hero.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = glow.getBoundingClientRect();
        glow.style.setProperty('--mx', `${e.clientX - r.left}px`);
        glow.style.setProperty('--my', `${e.clientY - r.top}px`);
      });
    });
  }
  // Hovering the primary action makes the Core delegate, as if asked something.
  document.querySelectorAll('[data-delegate]').forEach((el) =>
    el.addEventListener('pointerenter', () => window.dispatchEvent(new CustomEvent('salem:delegate'))),
  );
</script>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
  }
  .wordmark {
    margin: 0;
    text-decoration: none;
    font-size: 0.95rem;
    display: inline-flex;
  }
  .top nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
    font-size: 0.9375rem;
  }
  .top nav a,
  .foot nav a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .top nav a:hover,
  .foot nav a:hover {
    color: var(--text);
  }
  @media (max-width: 640px) {
    .top nav a:not(:last-child) {
      display: none;
    }
  }

  /* Hero: headline across the full width, Core beside the body copy */
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 7vw, 5rem) 3rem;
  }
  .hero > :not(.hero-glow) {
    position: relative;
  }
  /* A faint lamp glow that follows the pointer */
  .hero-glow {
    position: absolute;
    inset: -20% -30%;
    pointer-events: none;
    background: radial-gradient(
      600px circle at var(--mx, 70%) var(--my, 55%),
      rgba(232, 196, 106, 0.07),
      transparent 60%
    );
    transition: background-position 0.2s;
  }
  .line {
    display: block;
  }
  .w {
    display: inline-block;
    margin-right: 0.22em;
  }
  .w:last-child {
    margin-right: 0;
  }

  /* Entrance: words resolve from blur, then the body follows.
     While the intro plays, the sequence waits (delays do not elapse while paused). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .w,
    :global(html.js) .enter {
      animation: resolve 1.1s var(--ease-out) both;
      animation-delay: calc(var(--d) * 90ms + 120ms);
    }
    :global(html.js) .enter {
      animation-name: rise;
    }
    :global(html.intro:not(.intro-done)) .w,
    :global(html.intro:not(.intro-done)) .enter {
      animation-play-state: paused;
    }
  }
  @keyframes resolve {
    from {
      opacity: 0;
      filter: blur(14px);
      transform: translateY(0.18em);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .stage {
    color: var(--muted);
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
  }
  .stage-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lamp);
    margin-right: 0.65rem;
    box-shadow: 0 0 10px var(--lamp);
  }
  h1 {
    font-size: clamp(2.6rem, 7.2vw, 6rem);
    font-weight: 620;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }
  .hero-body {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .hero-body {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .hero-body :global(.hero-core) {
      margin-top: -2rem;
    }
  }
  .hero-body :global(.hero-core) {
    max-width: 30rem;
    justify-self: center;
  }
  @media (max-width: 899px) {
    .hero-body :global(.hero-core) {
      max-width: 22rem;
    }
  }
  .lede {
    margin-top: 2rem;
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
    max-width: 32rem;
  }
  .lede-2 {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: clamp(1.125rem, 1.6vw, 1.3rem);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .btn-primary {
    background: var(--lamp);
    border-color: var(--lamp);
    color: var(--night);
  }
  .btn-primary:hover {
    background: var(--lamp-hot);
    border-color: var(--lamp-hot);
  }

  /* Sections */
  .section {
    padding-top: var(--section);
  }
  h2 {
    font-size: clamp(2rem, 4.2vw, 3.25rem);
    max-width: 20ch;
  }
  .split {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
  .prose {
    color: var(--muted);
    max-width: 38rem;
  }
  .prose p + p {
    margin-top: 1.1rem;
  }
  h2 + .prose {
    margin-top: 1.5rem;
  }
  .split > h2 + .prose {
    margin-top: 0;
  }
  .intro-p {
    margin-top: 1.5rem;
    margin-bottom: 3rem;
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 3rem;
  }
  .status-line {
    color: var(--muted);
    font-size: 0.9375rem;
    max-width: 24rem;
  }
  #today .status-line {
    margin-top: 2rem;
  }

  /* World band: the page's second visual moment */
  .band {
    margin-top: var(--section);
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--coal);
    border-block: 1px solid var(--line);
  }

  /* Flow */
  .flow {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .flow li {
    position: relative;
    padding: 0 0 1.5rem 1.75rem;
    border-left: 1px solid var(--line);
  }
  .flow li:last-child {
    padding-bottom: 0;
  }
  .flow li::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.45rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--night);
    border: 1px solid var(--muted);
  }
  .flow li:nth-child(2)::before {
    background: var(--lamp);
    border-color: var(--lamp);
    box-shadow: 0 0 12px var(--lamp);
  }
  .flow span {
    display: block;
    color: var(--text);
    font-weight: 600;
  }
  .flow {
    position: relative;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .flow::after {
        content: '';
        position: absolute;
        left: 0;
        top: 0.45rem;
        bottom: 0;
        width: 1px;
        background: linear-gradient(var(--lamp), rgba(232, 196, 106, 0.2));
        transform-origin: top;
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
      .flow li:nth-child(2)::before {
        animation: kindle linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 50%;
      }
    }
  }
  @keyframes fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes kindle {
    from {
      background: var(--night);
      border-color: var(--muted);
      box-shadow: none;
    }
    to {
      background: var(--lamp);
      border-color: var(--lamp);
      box-shadow: 0 0 12px var(--lamp);
    }
  }

  /* Routes */
  .routes {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .route {
    display: grid;
    gap: 0.25rem 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 760px) {
    .route {
      grid-template-columns: 1.2fr 0.8fr 1.2fr;
      align-items: baseline;
    }
  }
  .route dt {
    color: var(--muted);
  }
  .route dd {
    margin: 0;
  }
  .route-to {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .route-to::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 1px;
    background: var(--lamp);
    vertical-align: 0.35em;
    margin-right: 0.75rem;
  }
  .route-why {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .route-to::before {
      width: 0;
      transition: width 0.7s var(--ease-out);
      transition-delay: calc(var(--r) * 0.32s + 0.15s);
    }
    :global(html.js) .route-to,
    :global(html.js) .route-why {
      opacity: 0.25;
      filter: blur(3px);
      transition:
        opacity 0.6s var(--ease-out),
        filter 0.6s var(--ease-out);
      transition-delay: calc(var(--r) * 0.32s + 0.45s);
    }
    :global(html.js) .route-why {
      transition-delay: calc(var(--r) * 0.32s + 0.6s);
    }
    .routes:global(.in) .route-to::before {
      width: 1.5rem;
    }
    .routes:global(.in) .route-to,
    .routes:global(.in) .route-why {
      opacity: 1;
      filter: none;
    }
  }
  .note {
    margin-top: 2.5rem;
    max-width: 44rem;
    color: var(--muted);
  }
  .note strong {
    color: var(--text);
    font-weight: 600;
  }

  /* Architecture */
  .arch {
    display: grid;
    gap: 1.25rem;
  }
  .arch > * {
    position: relative;
  }
  .arch > * + *::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -1.25rem;
    height: 1.25rem;
    width: 1px;
    background: var(--line);
  }
  @media (prefers-reduced-motion: no-preference) {
    .arch > * + *::after {
      content: '';
      position: absolute;
      left: calc(50% - 2.5px);
      top: -1.25rem;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--lamp-hot);
      box-shadow: 0 0 8px var(--lamp);
      opacity: 0;
      animation: flow-down 2.4s var(--ease-out) infinite paused;
    }
    .arch > :nth-child(3)::after {
      animation-delay: 0.5s;
    }
    .arch > :nth-child(4)::after {
      animation-delay: 1s;
    }
    .arch:global(.in) > *::after {
      animation-play-state: running;
    }
    .arch:global(.in) .arch-core {
      animation: breathe 2.4s ease-in-out 0.35s infinite;
    }
  }
  @keyframes flow-down {
    0% {
      opacity: 0;
      transform: translateY(0);
    }
    15% {
      opacity: 1;
    }
    45% {
      opacity: 1;
      transform: translateY(calc(1.25rem - 5px));
    }
    55%,
    100% {
      opacity: 0;
      transform: translateY(calc(1.25rem - 5px));
    }
  }
  @keyframes breathe {
    0%,
    100% {
      box-shadow: 0 0 0 rgba(232, 196, 106, 0);
    }
    40% {
      box-shadow: 0 0 28px rgba(232, 196, 106, 0.22);
    }
  }
  .arch-row {
