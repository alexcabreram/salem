---
// Illustrative SALEM World. All entities are fictional.
const nodes = [
  { id: 'you', label: 'You', x: 320, y: 215, r: 9, knows: 'Your preferences, routines and the people you work with. Only what you have allowed it to keep.' },
  { id: 'atlas', label: 'Project Atlas', x: 150, y: 110, r: 7, parent: 'you', knows: 'Open tasks, the decision log and who is involved. Since yesterday: two changes merged, one question waiting on you.' },
  { id: 'repo', label: 'Repository', x: 58, y: 42, r: 5, parent: 'atlas', knows: 'Latest changes, a failing check on the main branch and one review pending.' },
  { id: 'notes', label: 'Design notes', x: 60, y: 196, r: 5, parent: 'atlas', knows: 'The last three architecture decisions and the reasons behind them.' },
  { id: 'home', label: 'Home', x: 492, y: 110, r: 7, parent: 'you', knows: 'Which devices are online and what usually stays on at night.' },
  { id: 'thermo', label: 'Thermostat', x: 586, y: 40, r: 5, parent: 'home', knows: 'The current schedule. It can switch to away mode, and asks you first.' },
  { id: 'laptop', label: 'Laptop', x: 590, y: 196, r: 5, parent: 'home', knows: 'Last seen this morning. Backup completed overnight.' },
  { id: 'trip', label: 'Trip to Lisbon', x: 320, y: 352, r: 7, parent: 'you', knows: 'Dates, bookings and what needs to be ready before you leave.' },
  { id: 'cal', label: 'Calendar', x: 170, y: 392, r: 5, parent: 'trip', knows: 'Two meetings overlap with the trip. Neither has been moved yet.' },
  { id: 'flight', label: 'Flights', x: 470, y: 392, r: 5, parent: 'trip', knows: 'Outbound Tuesday morning. Check-in opens Monday.' },
];
const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

// Concept demo: one request, resolved across the map.
const mission = [
  { node: 'cal', area: 'Calendar', result: 'Two overlapping meetings found and flagged' },
  { node: 'flight', area: 'Travel', result: 'Check-in reminder set for Monday' },
  { node: 'thermo', area: 'Home', result: 'Away mode prepared, waiting for your approval' },
  { node: 'laptop', area: 'Infrastructure', result: 'Remote access checked' },
  { node: 'atlas', area: 'Tasks', result: 'Project Atlas handover note drafted' },
];
---

<div class="world" data-world data-reveal>
  <div class="graph">
    <svg viewBox="0 0 640 430" role="group" aria-label="Example map of what SALEM knows. Select an entity to see what it knows about it.">
      <g class="edges" aria-hidden="true">
        {nodes.filter((n) => n.parent).map((n) => (
          <line
            x1={byId[n.parent!].x}
            y1={byId[n.parent!].y}
            x2={n.x}
            y2={n.y}
            data-edge={`${n.parent}:${n.id}`}
          />
        ))}
      </g>
      <circle class="spark" r="5" cx="0" cy="0" aria-hidden="true" data-spark />
      {nodes.map((n) => (
        <g
          class="node"
          data-node={n.id}
          data-x={n.x}
          data-y={n.y}
          data-knows={n.knows}
          data-label={n.label}
          tabindex="0"
          role="button"
          aria-pressed={n.id === 'atlas' ? 'true' : 'false'}
          aria-label={n.label}
        >
          <circle class="hit" cx={n.x} cy={n.y} r="26" />
          <circle class="ring" cx={n.x} cy={n.y} r={n.r + 7} />
          <circle class="dot" cx={n.x} cy={n.y} r={n.r} />
          <text x={n.x} y={n.y + (n.y > 300 ? 30 : -17)} text-anchor="middle">{n.label}</text>
        </g>
      ))}
    </svg>
    <p class="hint">Select any point on the map.</p>
  </div>

  <div class="side">
    <div class="readout" aria-live="polite" data-readout>
      <p class="readout-q">What does SALEM know about <strong data-world-label>Project Atlas</strong>?</p>
      <p class="readout-a" data-world-knows>{byId.atlas.knows}</p>
    </div>

    <div class="mission" data-mission>
      <div class="mission-head">
        <span class="status status-concept">Concept demo</span>
      </div>
      <p class="mission-prompt">"I'm travelling to Lisbon next week. Make sure everything is ready."</p>
      <ol class="mission-steps" aria-live="polite">
        {mission.map((s) => (
          <li data-step={s.node} data-state="pending">
            <span class="step-mark" aria-hidden="true"></span>
            <span class="step-area">{s.area}</span>
            <span class="step-result">{s.result}</span>
            <span class="visually-hidden step-sr">Pending</span>
          </li>
        ))}
      </ol>
      <button type="button" class="btn mission-run" data-mission-run>Run the example</button>
    </div>
  </div>
</div>

<style>
  .world {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 960px) {
    .world {
      grid-template-columns: 1.45fr 1fr;
      gap: 4rem;
    }
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hint {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  .edges line {
    stroke: var(--line);
    stroke-width: 1;
    transition: stroke 0.25s;
  }
  .edges line.on {
    stroke: var(--lamp);
  }
  .spark {
    fill: var(--lamp-hot);
    opacity: 0;
    filter: drop-shadow(0 0 6px var(--lamp));
    pointer-events: none;
  }
  .node {
    cursor: pointer;
    outline: none;
  }
  .hit {
    fill: transparent;
  }
  .ring {
    fill: none;
    stroke: var(--lamp);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .dot {
    fill: var(--text);
    opacity: 0.7;
    transition: fill 0.25s, opacity 0.25s;
  }
  .node text {
    fill: var(--muted);
    font-family: var(--sans);
    font-size: 16px;
    transition: fill 0.25s;
  }
  @media (max-width: 600px) {
    .node text {
      font-size: 22px;
    }
    .hit {
      r: 40px;
    }
  }
  .node:hover .dot,
  .node[aria-pressed='true'] .dot,
  .node.working .dot {
    fill: var(--lamp);
    opacity: 1;
  }
  .node[aria-pressed='true'] .ring,
  .node.working .ring {
    opacity: 0.6;
  }
  .node:hover text,
  .node[aria-pressed='true'] text,
  .node.working text {
    fill: var(--text);
  }
  .node:focus-visible .hit {
    stroke: var(--lamp);
    stroke-width: 1.5;
  }

  .side {
    display: grid;
    gap: 3rem;
  }
  .readout {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    position: relative;
    min-height: 9rem;
  }
  .readout::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 1px;
    background: var(--lamp);
  }
  .readout-q {
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .readout-q strong {
    color: var(--text);
    font-weight: 600;
  }
  .readout-a {
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .mission-head {
    margin-bottom: 0.75rem;
  }
  .mission-prompt {
    font-size: 1.125rem;
    margin-bottom: 1.25rem;
  }
  .mission-steps {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .mission-steps li {
    display: grid;
    grid-template-columns: 1rem 7.5rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9375rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  .step-area {
    color: var(--text);
    opacity: 0.55;
    transition: opacity 0.3s;
  }
  .step-result {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .step-mark {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 1.5px dashed var(--muted);
    align-self: center;
  }
  li[data-state='working'] .step-mark {
    border: 1.5px solid var(--lamp);
    background: linear-gradient(90deg, var(--lamp) 50%, transparent 50%);
  }
  li[data-state='done'] .step-mark {
    border: 1.5px solid var(--lamp);
    background: var(--lamp);
  }
  li[data-state='working'] .step-area,
  li[data-state='done'] .step-area {
    opacity: 1;
  }
  li[data-state='done'] .step-result {
    opacity: 1;
  }
  @media (max-width: 520px) {
    .mission-steps li {
      grid-template-columns: 1rem 1fr;
    }
    .step-result {
      grid-column: 2;
    }
  }
  .mission-run {
    background: none;
    color: var(--text);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }
  .mission-run[disabled] {
    opacity: 0.5;
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-world]').forEach((root) => {
    const label = root.querySelector('[data-world-label]')!;
    const knows = root.querySelector('[data-world-knows]')!;
    const nodes = [...root.querySelectorAll<SVGGElement>('[data-node]')];
    const edges = [...root.querySelectorAll<SVGLineElement>('[data-edge]')];
    const byId = (id: string) => nodes.find((n) => n.dataset.node === id);

    const parentOf = new Map(edges.map((e) => e.dataset.edge!.split(':').reverse() as [string, string]));

    // Light the path from each active node back to "You".
    function highlightEdges(ids: Set<string>) {
      const path = new Set<string>();
      ids.forEach((id) => {
        for (let cur: string | undefined = id; cur && parentOf.has(cur); cur = parentOf.get(cur)) path.add(cur);
      });
      edges.forEach((e) => e.classList.toggle('on', path.has(e.dataset.edge!.split(':')[1])));
    }

    function select(g: SVGGElement) {
      const id = g.dataset.node!;
      nodes.forEach((n) => n.setAttribute('aria-pressed', String(n === g)));
      edges.forEach((e) => {
        const [a, b] = e.dataset.edge!.split(':');
        e.classList.toggle('on', a === id || b === id);
      });
      label.textContent = g.dataset.label!;
      knows.textContent = g.dataset.knows!;
    }

    nodes.forEach((g) => {
      g.addEventListener('click', () => select(g));
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          select(g);
        }
      });
    });
    const initial = byId('atlas');
    if (initial) select(initial);

    // Concept mission
    const run = root.querySelector<HTMLButtonElement>('[data-mission-run]');
    const steps = [...root.querySelectorAll<HTMLLIElement>('[data-step]')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, reduce ? 0 : ms));

    function setStep(li: HTMLLIElement, state: 'pending' | 'working' | 'done') {
      li.dataset.state = state;
      const sr = li.querySelector('.step-sr');
      if (sr) sr.textContent = state === 'done' ? 'Done' : state === 'working' ? 'In progress' : 'Pending';
    }

    // A spark of light that travels from "You" along the edges to a node.
    const spark = root.querySelector<SVGCircleElement>('[data-spark]');
    function chain(id: string) {
      const path: string[] = [];
      for (let cur: string | undefined = id; cur; cur = parentOf.get(cur)) path.unshift(cur);
      return path;
    }
    async function travel(id: string) {
      if (!spark || reduce) return;
      const pts = chain(id).map((n) => {
        const g = byId(n)!;
        return [Number(g.dataset.x), Number(g.dataset.y)];
      });
      const frames = pts.map(([x, y], i) => ({
        transform: `translate(${x}px, ${y}px)`,
        opacity: i === 0 || i === pts.length - 1 ? 0.2 : 1,
      }));
      frames[0].opacity = 0;
      await spark.animate(frames, { duration: 260 * (pts.length - 1) + 200, easing: 'cubic-bezier(.5,0,.3,1)' }).finished;
    }

    let ran = false;
    root.addEventListener('reveal', () => {
      if (!ran && !reduce) window.setTimeout(() => run?.click(), 600);
    });

    run?.addEventListener('click', async () => {
      ran = true;
      run.disabled = true;
      run.textContent = 'Running';
      nodes.forEach((n) => {
        n.classList.remove('working');
        n.setAttribute('aria-pressed', 'false');
      });
      steps.forEach((s) => setStep(s, 'pending'));
      const trip = byId('trip');
      trip?.classList.add('working');
      const lit = new Set<string>(['trip']);
      highlightEdges(lit);
      await wait(500);

      for (const li of steps) {
        const id = li.dataset.step!;
        setStep(li, 'working');
        lit.add(id);
        highlightEdges(lit);
        await travel(id);
        byId(id)?.classList.add('working');
        await wait(350);
        setStep(li, 'done');
      }
      await wait(300);
      run.disabled = false;
      run.textContent = 'Run it again';
    });
  });
</script>
