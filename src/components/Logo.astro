---
// SALEM mark: a familiar. The window is the cat's head and the light is its eyes.
// At rest it slow-blinks (in cats, a sign of trust); hovered, it opens its eyes and listens.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <path
      d="M12 44 V 12 L 23.5 21 H 40.5 L 52 12 V 44 A 10 10 0 0 1 42 54 H 22 A 10 10 0 0 1 12 44 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="4.8"
      stroke-linejoin="round"
    />
    <path
      class="eyes-rest"
      d="M21 37 Q 25.5 41 30 37 M34 37 Q 38.5 41 43 37"
      fill="none"
      stroke="#e8c46a"
      stroke-width="3.8"
      stroke-linecap="round"
    />
    <g class="eyes-open">
      <path
        d="M20.5 36.5 Q 25.5 30.5 30.5 36.5 Q 25.5 42.5 20.5 36.5 Z M33.5 36.5 Q 38.5 30.5 43.5 36.5 Q 38.5 42.5 33.5 36.5 Z"
        fill="#e8c46a"
      />
      <ellipse cx="25.5" cy="36.5" rx="1.1" ry="4" fill="#050607" />
      <ellipse cx="38.5" cy="36.5" rx="1.1" ry="4" fill="#050607" />
    </g>
  </svg>
  <span class="logo-word">SALEM</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  svg {
    flex: none;
    overflow: visible;
  }
  .logo-word {
    font-weight: 500;
    letter-spacing: 0.45em;
    margin-right: -0.45em;
  }
  .eyes-open {
    opacity: 0;
    transform-origin: 32px 36.5px;
    transform: scaleY(0.2);
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out);
  }
  .eyes-rest {
    transition: opacity 0.2s;
  }
  :global(a:hover) > .logo .eyes-open,
  :global(a:focus-visible) > .logo .eyes-open {
    opacity: 1;
    transform: none;
  }
  :global(a:hover) > .logo .eyes-rest,
  :global(a:focus-visible) > .logo .eyes-rest {
    opacity: 0;
  }
</style>
