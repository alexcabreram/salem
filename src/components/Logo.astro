---
// SALEM mark: a window left open, with the light outside it.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
const id = `salem-glow-${Math.random().toString(36).slice(2, 8)}`;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
    <defs>
      <radialGradient id={id} cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fff4d6" stop-opacity=".95" />
        <stop offset=".35" stop-color="#e8c46a" stop-opacity=".45" />
        <stop offset="1" stop-color="#e8c46a" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path
      d="M36 11 H 22 A 11 11 0 0 0 11 22 V 42 A 11 11 0 0 0 22 53 H 42 A 11 11 0 0 0 53 42 V 28"
      fill="none"
      stroke="currentColor"
      stroke-width="4.8"
      stroke-linecap="round"
    />
    <circle cx="48" cy="16" r="13" fill={`url(#${id})`} />
    <circle cx="48" cy="16" r="5.8" fill="#fff4d6" />
  </svg>
  <span class="logo-word">SALEM</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  svg {
    flex: none;
    overflow: visible;
  }
  .logo-word {
    font-weight: 500;
    letter-spacing: 0.45em;
    margin-right: -0.45em;
  }
</style>
