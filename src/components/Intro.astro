---
// Opening sequence, once per session: two eyes open in the dark, slow-blink,
// the familiar's outline draws around them and settles into the mark; then
// the name and a greeting. Skippable; never shown with reduced motion or without JS.
---

<div class="intro" data-intro aria-hidden="true">
  <svg class="intro-mark" viewBox="0 0 64 64" width="104" height="104">
    <defs>
      <radialGradient id="intro-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#fff4d6" stop-opacity=".9" />
        <stop offset=".4" stop-color="#e8c46a" stop-opacity=".4" />
        <stop offset="1" stop-color="#e8c46a" stop-opacity="0" />
      </radialGradient>
    </defs>
    <path
      class="intro-head"
      pathLength="1"
      d="M12 44 V 12 L 23.5 21 H 40.5 L 52 12 V 44 A 10 10 0 0 1 42 54 H 22 A 10 10 0 0 1 12 44 Z"
      fill="none"
      stroke="#e9e7e2"
      stroke-width="3.6"
      stroke-linejoin="round"
    />
    <g class="intro-open">
      <circle cx="25.5" cy="36.5" r="10" fill="url(#intro-glow)" />
      <circle cx="38.5" cy="36.5" r="10" fill="url(#intro-glow)" />
      <g class="lids">
        <path
          d="M20.5 36.5 Q 25.5 30.5 30.5 36.5 Q 25.5 42.5 20.5 36.5 Z M33.5 36.5 Q 38.5 30.5 43.5 36.5 Q 38.5 42.5 33.5 36.5 Z"
          fill="#e8c46a"
        />
        <ellipse cx="25.5" cy="36.5" rx="1.1" ry="4" fill="#050607" />
        <ellipse cx="38.5" cy="36.5" rx="1.1" ry="4" fill="#050607" />
      </g>
    </g>
    <path
      class="intro-rest"
      d="M21 37 Q 25.5 41 30 37 M34 37 Q 38.5 41 43 37"
      fill="none"
      stroke="#e8c46a"
      stroke-width="3"
      stroke-linecap="round"
    />
  </svg>
  <p class="intro-word">
    {'SALEM'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
  </p>
  <p class="intro-greeting" data-greeting>Good evening.</p>
  <button type="button" class="intro-skip" data-intro-skip tabindex="-1">Skip intro</button>
</div>

<style>
  .intro {
    display: none;
  }
  :global(html.intro) .intro {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.5rem;
    background: var(--night);
    transition: opacity 0.8s var(--ease-out), visibility 0.8s;
  }
  :global(html.intro-done) .intro {
    opacity: 0;
    visibility: hidden;
  }
  .intro-mark {
    overflow: visible;
  }

  /* 0.1s eyes open in the dark → 0.9s slow blink → 1.3s outline draws →
     2.1s eyes settle into the resting blink → 2.3s name → 2.8s greeting */
  .intro-open {
    opacity: 0;
    animation:
      appear 0.6s var(--ease-out) 0.1s forwards,
      settle 0.4s ease-in 2.1s forwards;
  }
  .lids {
    transform-origin: 32px 36.5px;
    animation: blink 0.7s ease-in-out 0.9s;
  }
  .intro-head {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 0.9s var(--ease-out) 1.3s forwards;
  }
  .intro-rest {
    opacity: 0;
    animation: appear 0.4s var(--ease-out) 2.3s forwards;
  }
  .intro-word {
    margin: 0;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.6em;
    margin-right: -0.6em;
  }
  .intro-word span {
    display: inline-block;
    opacity: 0;
    animation: letter 0.7s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 0.07s + 2.3s);
  }
  .intro-greeting {
    margin: 0;
    color: var(--muted);
    opacity: 0;
    animation: letter 0.8s var(--ease-out) 2.8s forwards;
  }
  .intro-skip {
    position: fixed;
    right: var(--gutter);
    bottom: var(--gutter);
    background: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    padding: 0.45rem 1rem;
    cursor: pointer;
  }
  .intro-skip:hover {
    color: var(--text);
    border-color: var(--muted);
  }
  @keyframes appear {
    to {
      opacity: 1;
    }
  }
  @keyframes settle {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes blink {
    0%,
    100% {
      transform: scaleY(1);
    }
    45%,
    55% {
      transform: scaleY(0.08);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes letter {
    from {
      opacity: 0;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }
</style>

<script>
  const html = document.documentElement;
  const root = document.querySelector<HTMLElement>('[data-intro]');
  if (root && html.classList.contains('intro')) {
    const h = new Date().getHours();
    const greeting = h >= 5 && h < 12 ? 'Good morning.' : h >= 12 && h < 19 ? 'Good afternoon.' : 'Good evening.';
    const g = root.querySelector('[data-greeting]');
    if (g) g.textContent = greeting;

    let finished = false;
    const finish = () => {
      if (finished) return;
      finished = true;
      html.classList.add('intro-done');
      try {
        sessionStorage.setItem('salem-intro', '1');
      } catch {}
      window.setTimeout(() => html.classList.remove('intro', 'intro-done'), 900);
    };
    window.setTimeout(finish, 3900);
    root.addEventListener('click', finish);
    window.addEventListener('keydown', finish, { once: true });
  }
</script>
